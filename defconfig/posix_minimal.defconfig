# POSIX reference configuration with Wi-Fi HTTP provisioning disabled.
#
# Mirror of defconfig/posix.defconfig (POSIX platform, tests and examples
# enabled) with the optional Wi-Fi HTTP provisioning application explicitly
# turned off. Used by TASK-133 to validate that a provisioning-disabled image
# contains no provisioning listeners, no captive DNS responder, and no packed
# portal assets.

CONFIG_HQ_PLATFORM_POSIX=y
CONFIG_HQ_PLATFORM_ESP=n
CONFIG_CMD_INPUT_TASK_STACK_SIZE=65536
CONFIG_CMD_INPUT_TASK_PRIORITY=5
CONFIG_OSAL_LOG_LEVEL=0
CONFIG_MONGOOSE_LOG_LEVEL=2
CONFIG_CMD_RX_BUFFER_SIZE=256
CONFIG_CMD_BUFFER_SIZE=256
CONFIG_CMD_HISTORY_BUFFER_SIZE=512
CONFIG_CMD_MAX_BINDING_COUNT=32
CONFIG_CMD_ENABLE_AUTOCOMPLETE=y
CONFIG_CMD_INVITATION="hq> "
# CONFIG_WIFI_HTTP_PROVISIONING is not set