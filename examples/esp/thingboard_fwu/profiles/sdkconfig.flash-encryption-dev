# IRREVERSIBLE HARDWARE CHANGE ON FIRST BOOT.
# Development mode permits limited plaintext reflashing but burns/protects a
# device flash-encryption key and changes security/debug eFuses permanently.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota_secure.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE is not set
