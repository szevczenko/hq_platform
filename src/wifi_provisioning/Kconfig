menu "Wi-Fi Provisioning"

config WIFI_HTTP_PROVISIONING
  bool "Enable Wi-Fi HTTP provisioning"
  default n
  help
    Build the Mongoose and OSAL based Wi-Fi provisioning portal,
    captive DNS responder, automatic fallback controller, and the
    explicit start/stop API.

if WIFI_HTTP_PROVISIONING

config WIFI_HTTP_PROVISIONING_AUTO_FALLBACK
  bool "Enable automatic provisioning fallback controller"
  default y
  help
    Start the provisioning portal automatically when no usable saved
    credentials exist or when saved credentials fail to connect.

config WIFI_HTTP_PROVISIONING_FALLBACK_ATTEMPTS
  int "Consecutive saved-credential connect failures before fallback"
  range 0 64
  default 1
  help
    Number of consecutive CONNECT_FAILED events observed while the automatic
    fallback controller is awaiting a saved-credential connection before the
    provisioning portal opens. A value of 1 preserves the historical
    first-failure behavior; 0 disables the fallback entirely (the
    no-saved-credential start-on-init path is not affected). The controller
    resets the budget on any successful connect and re-arms it when it returns
    to the awaiting-connect state from an online connection. A per-device
    override can be installed at init time through
    wifi_provisioning_controller_config_t.fallback_budget.

config WIFI_HTTP_PROVISIONING_HTTP_URL
  string "Provisioning HTTP listen URL"
  default "http://0.0.0.0:80"
  help
    Mongoose listen URL for the provisioning HTTP portal.

config WIFI_HTTP_PROVISIONING_DNS_URL
  string "Captive DNS listen URL"
  default "udp://0.0.0.0:53"
  help
    Mongoose listen URL for the captive DNS responder. POSIX tests and
    demos should use a high port (for example udp://127.0.0.1:10053).

config WIFI_HTTP_PROVISIONING_DNS_TTL
  int "Captive DNS answer TTL in seconds"
  range 0 300
  default 30
  help
    TTL advertised in captive DNS A-record responses.

config WIFI_HTTP_PROVISIONING_SUCCESS_GRACE_MS
  int "Portal grace period after connection in milliseconds"
  range 0 60000
  default 5000
  help
    Time the provisioning portal remains active after a successful
    station connection before transitioning to STA-only.

config WIFI_HTTP_PROVISIONING_BODY_MAX
  int "Provisioning request body size limit (bytes)"
  range 128 4096
  default 1024
  help
    Upper bound in bytes for provisioning request bodies, notably the
    JSON payload submitted to POST /api/v1/wifi/credentials. Larger
    payloads are rejected with HTTP 413 before they are buffered.

endif

endmenu